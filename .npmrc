# Capacitor's CLI bakes each native plugin's *resolved* path into generated files
# that we commit: ios/App/Podfile and android/capacitor.settings.gradle.
#
# With pnpm's default isolated linker those paths point into the store, e.g.
#   node_modules/.pnpm/@capacitor+ios@8.6.0_@capacitor+core@8.6.0/node_modules/@capacitor/ios
# which hardcodes exact versions plus a peer-dependency hash. Every dependency
# bump then rewrites both files, and they break for anyone whose resolution
# differs. A hoisted node_modules keeps those paths flat, stable and portable.
node-linker=hoisted
