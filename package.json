{
  "name": "shazarr-app",
  "private": true,
  "engines": {
    "node": ">=18",
    "npm": ">=10"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@typescript-eslint/parser": "^8.67.0",
    "@uidotdev/usehooks": "^2.4.1",
    "capacitor-voice-recorder": "^7.0.6",
    "node": "^26.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shazam-api": "^0.3.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@ionic/cli": "^7.2.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "depcheck": "^1.4.7",
    "eslint": "^10.8.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "ts-prune": "^0.10.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  },
  "scripts": {
    "start": "vite dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "ionic:serve": "pnpm run start",
    "ios:open": "ionic capacitor open ios",
    "ios:sync": "npx cap sync ios",
    "ios:live": "ionic capacitor run ios -l --external --port 5173",
    "android:open": "ionic capacitor open android",
    "android:sync": "npx cap sync android",
    "android:live": "ionic capacitor run android -l --external --port 5173",
    "quality:deadcode": "ts-prune | (! grep -v 'used in module')",
    "quality:depcheck": "npx depcheck",
    "quality:eslint": "eslint .",
    "quality:eslint-fix": "eslint --fix .",
    "testing:run": "docker run --rm -it -v .:/srv -w /srv mcr.microsoft.com/playwright:v1.62.1-noble sh -c 'npm i -g pnpm@10.28.2 && pnpm install --no-frozen-lockfile && npx playwright test'",
    "testing:ui": "npx playwright test --ui",
    "testing:ci": "docker run --rm -e CI=true -v .:/srv -w /srv mcr.microsoft.com/playwright:v1.62.1-noble sh -c 'npm i -g pnpm@10.28.2 && pnpm install --no-frozen-lockfile && npx playwright test'",
    "testing:show-report": "docker run --rm -it -p 9323:9323 -v .:/srv -w /srv mcr.microsoft.com/playwright:v1.62.1-noble npx playwright show-report ./testing/playwright-report --host 0.0.0.0",
    "testing:update-snapshots": "docker run --rm -it -v .:/srv -w /srv mcr.microsoft.com/playwright:v1.62.1-noble sh -c 'npm i -g pnpm@10.28.2 && pnpm install --no-frozen-lockfile && npx playwright test --update-snapshots'"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": ">=7.29.6",
      "@babel/runtime": ">=7.26.10 <8",
      "@xmldom/xmldom": ">=0.8.13",
      "basic-ftp": ">=5.3.0",
      "brace-expansion": ">=2.0.3",
      "diff": ">=5.2.2",
      "form-data": ">=4.0.6",
      "handlebars": ">=4.7.9",
      "ip-address": ">=10.3.1",
      "js-yaml": ">=4.3.1",
      "lodash": ">=4.18.0",
      "minimatch": ">=7.4.8",
      "qs": ">=6.15.2",
      "sharp": ">=0.35.0",
      "tar": ">=7.5.18",
      "tmp": ">=0.2.6",
      "uuid": ">=11.1.1",
      "yaml": ">=1.10.3"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
